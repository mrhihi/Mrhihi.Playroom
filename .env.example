# HTTP and WebSocket server settings
PORT=3838
HOST=0.0.0.0

# Optional public URL prefix, for example /playroom behind Nginx
# BASE_PATH=/playroom

# SQLite database file path
DATABASE_FILE=playroom.sqlite

# Optional: enables the /admin login page
# ADMIN_PASSWORD=replace-with-a-strong-password

# Optional production-only AdSense snippets; keep their contents outside Git
# NODE_ENV=production
# ADSENSE_ENABLED=1
# ADSENSE_HEAD_FILE=/home/ubuntu/Workspace/playroom/private/adsense/head.html
# ADSENSE_UNIT_FILE=/home/ubuntu/Workspace/playroom/private/adsense/unit.html
