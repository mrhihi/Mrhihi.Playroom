{
  "name": "playroom",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run build:browser",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "build:browser": "esbuild src/ui/solo.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/browser/solo.js",
    "predev": "npm run build:browser"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.36.0",
    "fastify": "^5.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.2",
    "jsdom": "^27.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
